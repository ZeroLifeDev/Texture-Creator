<Window x:Class="TextureCreator.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PBR Reference Forge" Width="1440" Height="900" MinWidth="1050" MinHeight="680" Background="#17191D" Foreground="#E8EAED" WindowStartupLocation="CenterScreen">
 <Grid><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition/><RowDefinition Height="130"/><RowDefinition Height="28"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#22252A" BorderBrush="#34383F" BorderThickness="0,0,0,1"><DockPanel Margin="8,5"><StackPanel Orientation="Horizontal">
   <TextBlock Text="PBR REFERENCE FORGE" Foreground="{StaticResource Accent}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,18,0"/>
   <Button Content="Import Model" Click="ImportModel_Click"/><Button Content="Add References" Click="AddReference_Click"/><Button Content="Open Project" Click="Open_Click"/><Button Content="Save Project" Click="Save_Click"/><Button Content="Generate" Background="#277A64" Click="Generate_Click"/><Button Content="Export" Click="Export_Click"/>
  </StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right"><Button Content="Quick Export" Click="ShowQuick_Click"/><Button Content="Web Assist" Click="WebAssist_Click"/><Button Content="Open Logs" Click="Logs_Click"/><Button Content="About" Click="About_Click"/></StackPanel></DockPanel></Border>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition/><ColumnDefinition Width="285"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource Panel}" BorderBrush="#353A42" BorderThickness="0,0,1,0"><DockPanel><TextBlock DockPanel.Dock="Top" Text="PROJECT" FontWeight="SemiBold" Margin="14"/><TabControl Background="Transparent" BorderThickness="0"><TabItem Header="Assets"><StackPanel Margin="10"><TextBlock Text="MODEL" Foreground="#888F98" Margin="3,8"/><TextBlock x:Name="ModelName" Text="No model imported" TextWrapping="Wrap" Margin="3"/><TextBlock x:Name="MeshStats" Text="OBJ / GLB / GLTF" Foreground="#90969E" Margin="3,0,3,12"/><TextBlock Text="REFERENCES" Foreground="#888F98" Margin="3,8"/><ListBox x:Name="ReferenceList" Background="#191B1F" Foreground="#DADDE1" BorderThickness="0" MinHeight="180" SelectionChanged="ReferenceList_SelectionChanged"/></StackPanel></TabItem><TabItem Header="UV"><Grid Background="#15171A"><Image x:Name="UvImage" Stretch="Uniform" Margin="8"/><TextBlock x:Name="UvEmpty" Text="Import a UV-mapped model" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#777D85"/></Grid></TabItem></TabControl></DockPanel></Border>
   <Grid Grid.Column="1" Background="#0F1114"><Image x:Name="ReferenceBackdrop" Stretch="Uniform" Opacity="0.55" IsHitTestVisible="False"/><Viewport3D x:Name="Viewport" ClipToBounds="True" MouseDown="Viewport_MouseDown" MouseMove="Viewport_MouseMove" MouseUp="Viewport_MouseUp" MouseWheel="Viewport_MouseWheel"><Viewport3D.Camera><PerspectiveCamera x:Name="Camera" Position="0,0,4" LookDirection="0,0,-4" UpDirection="0,1,0" FieldOfView="45"/></Viewport3D.Camera></Viewport3D><Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="9,5" CornerRadius="3" Background="#B015171A"><TextBlock x:Name="ViewportMode" Text="PBR Preview  •  drag orbit  •  wheel zoom"/></Border></Grid>
   <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="#353A42" BorderThickness="1,0,0,0"><ScrollViewer><StackPanel Margin="12"><TextBlock Text="MATERIAL &amp; GENERATION" FontWeight="SemiBold" Margin="4,3,4,14"/><Label Content="Selected reference view"/><ComboBox x:Name="RoleCombo" SelectionChanged="RoleCombo_SelectionChanged"/><Label Content="Material type"/><ComboBox x:Name="MaterialCombo"/><Label Content="Texture resolution"/><ComboBox x:Name="ResolutionCombo" SelectedIndex="1"><ComboBoxItem Content="1024"/><ComboBoxItem Content="2048"/><ComboBoxItem Content="4096"/><ComboBoxItem Content="8192"/></ComboBox><Label Content="Roughness"/><Slider x:Name="RoughnessSlider" Minimum="0" Maximum="1" Value="0.55" TickFrequency="0.05"/><Label Content="Metalness"/><Slider x:Name="MetalSlider" Minimum="0" Maximum="1" Value="0" TickFrequency="0.05"/><Label Content="Normal strength"/><Slider x:Name="NormalSlider" Minimum="0" Maximum="4" Value="1"/><Separator Margin="3,16"/><CheckBox x:Name="WireframeCheck" Content="Wireframe overlay" Foreground="#D4D7DC" Margin="5" Checked="ViewOption_Changed" Unchecked="ViewOption_Changed"/><CheckBox x:Name="SeamsCheck" Content="UV seam debug" Foreground="#D4D7DC" Margin="5" Checked="ViewOption_Changed" Unchecked="ViewOption_Changed"/><Label Content="Reference overlay opacity" Margin="0,12,0,0"/><Slider x:Name="OverlaySlider" Minimum="0" Maximum="1" Value=".55" ValueChanged="OverlaySlider_ValueChanged"/><TextBlock Text="All processing stays local unless Web Assist is explicitly invoked. Generated height is plausible relief, not measured geometry." TextWrapping="Wrap" Foreground="#8F969F" Margin="5,18,5,5"/></StackPanel></ScrollViewer></Border>
  </Grid>
  <Border Grid.Row="2" Background="#1D2024" BorderBrush="#34383F" BorderThickness="0,1,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="12"><TextBlock Text="MAPS" FontWeight="SemiBold"/><TextBlock x:Name="MapHint" Text="Generate a texture set to inspect maps" Foreground="#888F98" TextWrapping="Wrap" Margin="0,8"/></StackPanel><ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><ItemsControl x:Name="MapStrip"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer></Grid></Border>
  <Border Grid.Row="3" Background="#15171A"><Grid><ProgressBar x:Name="Progress" Height="3" VerticalAlignment="Top" Foreground="{StaticResource Accent}" Visibility="Collapsed"/><TextBlock x:Name="Status" Text="Ready — local deterministic mode" Margin="10,6" FontSize="11" Foreground="#969CA5"/></Grid></Border>
  <Grid x:Name="QuickWorkspace" Grid.RowSpan="4" Panel.ZIndex="20" Background="#17191D">
   <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition/><RowDefinition Height="42"/></Grid.RowDefinitions>
   <Border Background="#22252A" BorderBrush="#34383F" BorderThickness="0,0,0,1"><DockPanel LastChildFill="False" Margin="18,10"><StackPanel Orientation="Horizontal"><Border Width="38" Height="38" CornerRadius="8" Background="#277A64" Margin="0,0,12,0"><TextBlock Text="P" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="PBR REFERENCE FORGE" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/><TextBlock Text="Quick Texture Export" Foreground="#9299A2" FontSize="11"/></StackPanel></StackPanel><Button DockPanel.Dock="Right" Content="Advanced Workspace" Padding="16,8" Click="ShowAdvanced_Click"/><Button x:Name="ChatGptAccountButton" DockPanel.Dock="Right" Content="Connect ChatGPT Browser Account" Padding="16,8" Click="ChatGptSignIn_Click"/></DockPanel></Border>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel MaxWidth="1040" Margin="36,34" HorizontalAlignment="Center">
    <TextBlock Text="Create a complete PBR texture set" FontSize="30" FontWeight="SemiBold" Foreground="#F1F3F5" HorizontalAlignment="Center"/>
    <TextBlock Text="Import a UV-mapped model or a UV layout image, then add one texture reference. Receive six maps in one ZIP." FontSize="14" Foreground="#9DA4AD" HorizontalAlignment="Center" Margin="0,8,0,28"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="22"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Border Grid.Column="0" Background="#202328" BorderBrush="#343A42" BorderThickness="1" CornerRadius="8" Padding="22"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="1  UV SOURCE" Foreground="#7F8790" FontWeight="SemiBold"/><TextBlock x:Name="QuickModelLabel" Text="No UV source selected" FontSize="18" Foreground="#E4E7EA" Margin="0,18,0,5" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="QuickModelDetails" Text="3D model with UVs, or a UV layout PNG/JPG" Foreground="#8F969F" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,24,0,0"><Button Content="Choose 3D Model…" Margin="0,0,6,0" Padding="12,10" Click="ImportModel_Click"/><Button Content="Choose UV Map Image…" Margin="0" Padding="12,10" Click="QuickUvImage_Click"/></StackPanel></Grid></Border>
     <Border Grid.Column="2" Background="#202328" BorderBrush="#343A42" BorderThickness="1" CornerRadius="8" Padding="22"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="2  TEXTURE REFERENCE" Foreground="#7F8790" FontWeight="SemiBold"/><TextBlock x:Name="QuickReferenceLabel" Text="No image selected" FontSize="18" Foreground="#E4E7EA" Margin="0,18,10,5" TextTrimming="CharacterEllipsis"/><TextBlock Text="PNG, JPG, JPEG or WebP" Foreground="#8F969F"/></StackPanel><Border Grid.Column="1" Width="102" Height="102" Background="#15171A" BorderBrush="#343A42" BorderThickness="1" CornerRadius="5"><Image x:Name="QuickReferencePreview" Stretch="UniformToFill"/></Border><Button Grid.Row="1" Content="Choose Reference…" Margin="0,24,0,0" Padding="16,10" HorizontalAlignment="Left" Click="QuickReference_Click"/></Grid></Border>
    </Grid>
    <Border Background="#202328" BorderBrush="#343A42" BorderThickness="1" CornerRadius="8" Padding="22" Margin="0,22,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="RESOLUTION" Foreground="#7F8790" FontWeight="SemiBold"/><ComboBox x:Name="QuickResolutionCombo" SelectedIndex="1" Margin="0,10,24,0"><ComboBoxItem Content="1024"/><ComboBoxItem Content="2048"/><ComboBoxItem Content="4096"/><ComboBoxItem Content="8192"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="MATERIAL" Foreground="#7F8790" FontWeight="SemiBold"/><ComboBox x:Name="QuickMaterialCombo" Margin="0,10,24,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="ZIP CONTENTS" Foreground="#7F8790" FontWeight="SemiBold"/><WrapPanel Margin="0,10,0,0"><TextBlock Text="✓ Diffuse   ✓ Albedo   ✓ Roughness   ✓ Normal   ✓ Displacement   ✓ Metalness" Foreground="#B7E8D8" TextWrapping="Wrap"/></WrapPanel></StackPanel></Grid></Border>
    <Button x:Name="QuickGenerateButton" Content="Generate PBR ZIP" Background="#277A64" BorderBrush="#3EB891" Foreground="White" FontSize="17" FontWeight="SemiBold" Padding="28,14" HorizontalAlignment="Center" Margin="0,28,0,0" Click="QuickGenerate_Click"/>
    <ProgressBar x:Name="QuickProgress" Height="5" Margin="160,18,160,0" Foreground="{StaticResource Accent}" Visibility="Collapsed"/>
    <TextBlock x:Name="QuickStatus" Text="Everything runs locally. Your model and reference stay on this computer." Foreground="#89919B" HorizontalAlignment="Center" Margin="0,12,0,0"/>
   </StackPanel></ScrollViewer>
   <Border Grid.Row="2" Background="#15171A" BorderBrush="#292D33" BorderThickness="0,1,0,0"><DockPanel LastChildFill="False" Margin="14,8"><TextBlock Text="Local deterministic pipeline  •  no paid API required" Foreground="#747C85"/><TextBlock DockPanel.Dock="Right" Text="v0.3.2-alpha" Foreground="#747C85"/></DockPanel></Border>
  </Grid>
 </Grid>
</Window>
