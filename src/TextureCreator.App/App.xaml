<Application x:Class="TextureCreator.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Panel" Color="#202328"/><SolidColorBrush x:Key="Panel2" Color="#292D33"/><SolidColorBrush x:Key="Accent" Color="#46C79C"/>
    <Style TargetType="Button"><Setter Property="Foreground" Value="#E8EAED"/><Setter Property="Background" Value="#343941"/><Setter Property="BorderBrush" Value="#444B54"/><Setter Property="Padding" Value="12,6"/><Setter Property="Margin" Value="3"/></Style>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#D4D7DC"/></Style>
    <Style TargetType="Label"><Setter Property="Foreground" Value="#AEB4BC"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="6"/></Style>
  </Application.Resources>
</Application>
